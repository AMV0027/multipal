{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "next/link": ["./src/lib/next-compat.tsx"],
      "next/navigation": ["./src/lib/next-compat.tsx"]
    }
  },
  "include": ["src"]
}
